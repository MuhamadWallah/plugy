# ==========================================================
# Plugy - Production environment (docker-compose.prod.yml)
# ==========================================================
# Copy to .env.production (git-ignored), fill in every value marked REQUIRED, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public URL users open in the browser, scheme included, no trailing slash. REQUIRED
# Used as the allowed CORS / WebSocket origin. Comma-separate several (e.g. apex + www).
PUBLIC_URL=https://plugy.example.com

# Session signing secret, at least 32 characters. REQUIRED
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Bundled PostgreSQL. REQUIRED: choose a strong password (letters/digits only,
# or URL-encode it, because it is embedded in the connection URL).
POSTGRES_USER=plugy
POSTGRES_PASSWORD=
POSTGRES_DB=plugy

# Optional: use a managed database instead of the bundled one
# DATABASE_URL=postgres://user:password@db.example.com:5432/plugy?sslmode=require

# Where the web container listens. Keep 0.0.0.0:80 when this host serves traffic directly;
# use HTTP_BIND=127.0.0.1 and another port when a TLS proxy on the same host forwards to it.
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# Session cookie is HTTPS-only. Only set false for a temporary plain-HTTP test deployment.
COOKIE_SECURE=true

# Number of reverse proxies in front of the API: 1 = the bundled nginx only.
# Use 2 if another proxy/CDN (Caddy, Cloudflare, load balancer) sits in front of nginx.
TRUST_PROXY=1

# Rate limits per client IP per 15-minute window
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_JOBS_MAX=30
RATE_LIMIT_OFFERS_MAX=60

# Run database migrations automatically when the backend starts
RUN_MIGRATIONS=true

# Open "as soon as possible" requests close after this many hours without a hire
# (scheduled requests close 2 hours after their requested time)
JOB_OPEN_HOURS=72

# Number on the in-app Safety screen. 112 works from most mobile networks;
# set your country's number if different (e.g. 999, 911, 10111).
EMERGENCY_NUMBER=112

# Accounts that can review safety reports and suspend users (comma-separated emails)
ADMIN_EMAILS=

# Push notifications (alerts when Plugy is closed). Generate once with:
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
# Keep the same keys forever; changing them makes every device re-subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@plugy.example.com

# SMS delivery for phone verification codes (Twilio). Without these, codes are only
# written to the backend log, so users cannot verify phones in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
