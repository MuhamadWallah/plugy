# ==========================================
# Plugy - Environment Configuration Template
# ==========================================

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Application Secrets (Must be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
POSTGRES_USER=plugy
POSTGRES_PASSWORD=plugy_secret
POSTGRES_DB=plugy
POSTGRES_PORT=5434

# Full Database Connection URL (e.g. AWS RDS, Supabase, Neon in production)
DATABASE_URL=postgres://plugy:plugy_secret@localhost:5434/plugy

# Network & Port Mappings
BACKEND_PORT=5001
FRONTEND_PORT=5174
PORT=5000

# CORS & Security
CORS_ORIGIN=http://localhost:5174
COOKIE_SECURE=false

# Rate Limiting (per 15-minute window)
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_JOBS_MAX=30
